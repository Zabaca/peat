[submodule "vendor/postgres-v14"]
	path = vendor/postgres-v14
	# The relative URL resolves against this fork's own remote (which has no postgres repo)
	# url = ../postgres.git
	url = https://github.com/neondatabase/postgres.git
	branch = REL_14_STABLE_neon
[submodule "vendor/postgres-v15"]
	path = vendor/postgres-v15
	# The relative URL resolves against this fork's own remote (which has no postgres repo)
	# url = ../postgres.git
	url = https://github.com/neondatabase/postgres.git
	branch = REL_15_STABLE_neon
[submodule "vendor/postgres-v16"]
	path = vendor/postgres-v16
	# The relative URL resolves against this fork's own remote (which has no postgres repo)
	# url = ../postgres.git
	url = https://github.com/neondatabase/postgres.git
	branch = REL_16_STABLE_neon
[submodule "vendor/postgres-v17"]
	path = vendor/postgres-v17
	# The relative URL resolves against this fork's own remote (which has no postgres repo)
	# url = ../postgres.git
	url = https://github.com/neondatabase/postgres.git
	branch = REL_17_STABLE_neon
[submodule "vendor/postgres-v18"]
	path = vendor/postgres-v18
	# Peat's Postgres 18 lives in its own repository, peat-postgres (a fork of Neon's
	# neondatabase/postgres), published beside this one: the relative URL resolves
	# against this repository's own remote.
	url = ../peat-postgres.git
	branch = REL_18_STABLE_peat
